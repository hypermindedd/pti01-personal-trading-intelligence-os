{
  "project": "PTI.01",
  "version": "0.1.0",
  "mode": "READ_ONLY",
  "default_decision": "DENY",
  "allowed_capabilities": [
    "observe.account_metadata_sanitized",
    "observe.trade_transactions",
    "observe.chart_objects",
    "observe.market_ticks",
